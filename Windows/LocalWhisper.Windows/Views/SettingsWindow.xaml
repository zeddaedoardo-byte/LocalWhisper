<Window x:Class="LocalWhisper.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalWhisper Settings"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="HelpText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   Foreground="#334155"
                   Text="{Binding StatusMessage}" />
        <Button Grid.Column="1"
                Content="Restart pipeline"
                Command="{Binding RestartPipelineCommand}" />
      </Grid>
    </Border>

    <TabControl Margin="16">
      <TabItem Header="Whisper">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,4">
            <TextBlock Style="{StaticResource LabelText}" Text="whisper.cpp binary" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Settings.WhisperBinaryPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1"
                      Content="Browse"
                      Command="{Binding BrowseBinaryCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Text="LocalWhisper expects whisper-cli.exe and whisper-server.exe in the same folder." />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,4" Text="Model" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Settings.ModelPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1"
                      Content="Browse"
                      Command="{Binding BrowseModelCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Text="Default path: %LOCALAPPDATA%\LocalWhisper\Models\ggml-large-v3-turbo.bin." />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Download Large V3 Turbo"
                      Command="{Binding DownloadModelCommand}" />
              <Button Content="Reset paths"
                      Command="{Binding ResetPathsCommand}" />
            </StackPanel>
            <ProgressBar Height="8"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ModelDownloadProgress}" />
            <TextBlock Style="{StaticResource HelpText}" Text="{Binding ModelDownloadLabel}" />

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource LabelText}" Text="Language" />
                <TextBox Text="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HelpText}" Text="Use auto, en, it, es, fr, de, or another whisper.cpp language code." />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource LabelText}" Text="Performance preset" />
                <ComboBox ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Settings.PerformancePresetId, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Input">
        <StackPanel Margin="4,14,4,4">
          <TextBlock Style="{StaticResource LabelText}" Text="Microphone" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Devices}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding Settings.PreferredMicId, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshDevicesCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Test microphone"
                    Command="{Binding TestMicrophoneCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="#334155"
                       Text="{Binding MicTestResult}" />
          </StackPanel>

          <TextBlock Style="{StaticResource LabelText}" Margin="0,24,0,4" Text="Push-to-talk hotkey" />
          <ComboBox Width="260"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Triggers}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Id"
                    SelectedValue="{Binding Settings.PushToTalkTriggerId, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource HelpText}" Text="Windows does not expose the Mac fn key to normal apps, so Left Ctrl is the default trigger." />
        </StackPanel>
      </TabItem>

      <TabItem Header="Output">
        <StackPanel Margin="4,14,4,4">
          <CheckBox Content="Automatically paste transcript into the active app"
                    IsChecked="{Binding Settings.AutoPaste, Mode=TwoWay}" />
          <CheckBox Margin="0,12,0,0"
                    Content="Play start and stop sounds"
                    IsChecked="{Binding Settings.PlaySounds, Mode=TwoWay}" />
          <CheckBox Margin="0,12,0,0"
                    Content="Launch LocalWhisper at login"
                    IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,4">
            <TextBlock Style="{StaticResource LabelText}" Text="Server" />
            <TextBlock Text="{Binding StatusMessage}" />
            <TextBlock Style="{StaticResource HelpText}" Text="The server keeps the Whisper model resident after warmup." />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,4" Text="Last error" />
            <TextBox Text="{Binding LastError}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,4" Text="Last transcript" />
            <TextBox Text="{Binding LastTranscript}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,4" Text="Time saved" />
            <TextBlock Text="{Binding TotalTimeSavedLabel}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
