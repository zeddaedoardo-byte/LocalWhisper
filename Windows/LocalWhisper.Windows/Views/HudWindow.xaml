<Window x:Class="LocalWhisper.Windows.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
  <Border Background="#F8FAFC"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8"
          Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="TitleText"
                 FontSize="16"
                 FontWeight="SemiBold"
                 Foreground="#0F172A"
                 Text="Recording" />
      <TextBlock x:Name="DetailText"
                 Grid.Row="2"
                 FontSize="13"
                 Foreground="#475569"
                 TextTrimming="CharacterEllipsis" />
      <ProgressBar x:Name="LevelBar"
                   Grid.Row="2"
                   Height="4"
                   VerticalAlignment="Bottom"
                   Minimum="0"
                   Maximum="100"
                   Value="0"
                   Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
